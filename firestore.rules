rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ==================== Users ====================
    match /users/{userId} {
      // Single-doc reads: any signed-in user (member names, Wave phone lookup, profile)
      allow get: if isSignedIn();
      // List queries must be bounded to prevent bulk dumps of phone numbers.
      // Every client query on /users uses .limit(n) with n <= 20.
      allow list: if isSignedIn() && request.query.limit <= 20;

      // Only self can create; phoneNumber must match the phone-auth token
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.displayName is string
        && request.resource.data.keys().hasOnly(
          ['phoneNumber', 'displayName', 'qrCode', 'createdAt', 'updatedAt', 'avatarUrl']);

      // Only self can update; phoneNumber, qrCode and createdAt are immutable
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'avatarUrl', 'updatedAt', 'fcmToken']);

      allow delete: if false;

      // -------- Friends --------
      match /friends/{friendId} {
        allow read: if isSignedIn() && request.auth.uid == userId;

        // Owner adds a friend to their own list
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['addedAt']);

        // A non-owner may add themselves ONLY while accepting a real pending
        // friend request from {userId}: the request doc must exist before the
        // batch and be consumed (deleted) by the same batch.
        allow create: if isSignedIn()
          && request.auth.uid == friendId
          && request.resource.data.keys().hasOnly(['addedAt'])
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId)).data.fromUserId == userId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId)).data.status == 'pending'
          && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId));

        allow update: if false;

        // Owner removes a friend; the removed friend deletes the mirror doc
        allow delete: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // -------- Friend requests (doc id == sender uid) --------
      match /friend_requests/{requestId} {
        // Owner reads their inbox; the sender may `get` their own request (dedup)
        allow get: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == requestId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        // Only the sender can create a request, in someone else's inbox,
        // with truthful fromUserId and status 'pending'
        allow create: if isSignedIn()
          && request.auth.uid == requestId
          && request.auth.uid != userId
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.fromDisplayName is string
          && request.resource.data.keys().hasOnly(
            ['fromUserId', 'fromDisplayName', 'fromPhoneNumber', 'status', 'createdAt']);

        // Requests are immutable; accept/decline delete them
        allow update: if false;

        // Owner (accept/decline) or sender (cancel) may delete
        allow delete: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == requestId);
      }

      // -------- Notifications --------
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;

        // Cross-user creation restricted to the friend-request flow, with the
        // notification bound to a real friend_requests doc
        allow create: if isSignedIn()
          && request.auth.uid != userId
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.isRead == false
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.keys().hasOnly(
            ['type', 'title', 'body', 'fromUserId', 'fromDisplayName',
             'requestId', 'createdAt', 'isRead'])
          && (
            // "friend_request": same batch creates the request in {userId}'s inbox
            (request.resource.data.type == 'friend_request'
              && existsAfter(/databases/$(database)/documents/users/$(userId)/friend_requests/$(request.auth.uid)))
            ||
            // "friend_request_accepted": same batch consumes {userId}'s request
            (request.resource.data.type == 'friend_request_accepted'
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId))
              && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId)))
          );

        // Owner can only mark as read
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ==================== Groups ====================
    match /groups/{groupId} {

      function groupDoc() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function groupDocAfter() {
        return getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function isGroupMember() {
        return isSignedIn() && request.auth.uid in groupDoc().memberIds;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Creator must be in memberIds and be createdBy
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly(
          ['name', 'description', 'imageUrl', 'createdBy', 'createdAt',
           'updatedAt', 'memberIds', 'currency', 'simplifyDebts']);

      // Members only; createdBy/createdAt immutable; memberIds changes limited to
      // additions (QR invite by a member) and self-removal (leave group)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdBy', 'createdAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds'])
          || (
            request.resource.data.memberIds is list
            && resource.data.memberIds.toSet()
                .difference(request.resource.data.memberIds.toSet())
                .hasOnly([request.auth.uid])
          )
        );

      // Only the creator can delete a group
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      // -------- Members subcollection --------
      match /members/{memberId} {
        allow read: if isGroupMember();

        // Written by a member (group creation batch or addMember flow);
        // the member doc must belong to someone in the (post-write) member list
        allow create: if isSignedIn()
          && request.auth.uid in groupDocAfter().memberIds
          && memberId in groupDocAfter().memberIds
          && request.resource.data.keys().hasOnly(['joinedAt', 'role', 'balance'])
          && request.resource.data.role in ['admin', 'member'];

        allow update: if false;

        // Self-removal (leave group) or purge by the creator (deleteGroup runs
        // chunked batches, so the group doc is deleted after the subcollections)
        allow delete: if isSignedIn()
          && (
            request.auth.uid == memberId
            || request.auth.uid == groupDoc().createdBy
          );
      }

      // -------- Expenses --------
      match /expenses/{expenseId} {
        allow read: if isGroupMember();

        allow create: if isGroupMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidBy in groupDoc().memberIds
          && request.resource.data.isDeleted == false
          && request.resource.data.description is string
          && request.resource.data.keys().hasOnly(
            ['description', 'amount', 'currency', 'paidBy', 'createdBy',
             'createdAt', 'updatedAt', 'date', 'category', 'imageUrl',
             'splitType', 'splits', 'isDeleted']);

        // Only the author can edit (including the isDeleted soft delete)
        allow update: if isGroupMember()
          && resource.data.createdBy == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdBy', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidBy'])
            || request.resource.data.paidBy in groupDoc().memberIds
          );

        // Hard delete: only the author, or the group creator (deleteGroup purges
        // subcollections in chunked batches before deleting the group doc)
        allow delete: if isSignedIn()
          && (
            (isGroupMember() && resource.data.createdBy == request.auth.uid)
            || request.auth.uid == groupDoc().createdBy
          );
      }

      // -------- Settlements --------
      match /settlements/{settlementId} {
        allow read: if isGroupMember();

        // Recorded by one of the two parties, both parties must be members
        allow create: if isGroupMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.fromUserId in groupDoc().memberIds
          && request.resource.data.toUserId in groupDoc().memberIds
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.auth.uid in
            [request.resource.data.fromUserId, request.resource.data.toUserId]
          && request.resource.data.status == 'confirmed'
          && request.resource.data.paymentMethod in ['manual', 'wave']
          && request.resource.data.keys().hasOnly(
            ['fromUserId', 'toUserId', 'amount', 'currency', 'note', 'createdBy',
             'createdAt', 'confirmedAt', 'status', 'paymentMethod']);

        // Settlements are immutable receipts
        allow update: if false;

        // Only the author, or the group creator (deleteGroup purge)
        allow delete: if isSignedIn()
          && (
            (isGroupMember() && resource.data.createdBy == request.auth.uid)
            || request.auth.uid == groupDoc().createdBy
          );
      }
    }
  }
}
